# PHPStan configuration for codexpertio/plugin-tracker-sdk.
#
# Level 5 to start (composer.json only requires php-stubs/wordpress-stubs and phpstan/phpstan
# as dev dependencies; nothing here assumes a richer analysis baseline yet). Only `src/` is
# analysed -- tests/ exercise WP behaviour through Brain Monkey mocks, which is a PHPUnit
# concern, not a static-analysis one.
#
# phpVersion is pinned to 70200 to match the SDK's distribution floor (composer.json
# config.platform.php = 7.2.5). This is a distribution decision, not a preference: the SDK
# ships inside third-party WordPress plugins, so its floor becomes theirs. Do not raise this to
# match plugins/plugin-tracker (which targets 7.4) -- that package is not bundled elsewhere and
# has no reason to share this SDK's floor.
#
# No `includes:` for any extension.neon here. phpstan/extension-installer is only *allow-listed*
# in composer.json's config.allow-plugins, it is not actually required as a dependency, so
# nothing under vendor/phpstan/ registers itself automatically (confirmed: vendor/phpstan/
# contains only phpstan/phpstan itself). Manually including an extension.neon that
# extension-installer also auto-registers is a hard error ("sniff/extension already loaded"
# style conflict) -- since no such extension is installed, there is nothing to include and
# nothing to conflict.
#
# No baseline. There was one, carrying two findings where add_option()'s $autoload argument was
# passed the legacy string 'no' -- WordPress 6.7 deprecated the 'yes'/'no' form in favour of
# true/false/null, and php-stubs/wordpress-stubs now types the parameter bool|null. Both call
# sites were fixed to pass false, which emptied the baseline, so it was deleted rather than kept
# as an empty file. An empty baseline is worse than none: PHPStan reports unmatched ignoreErrors
# entries as errors, so a stale baseline fails the build for no reason.
parameters:
	level: 5
	phpVersion: 70200
	paths:
		- src

	# php-stubs/wordpress-stubs ships pure declarations (functions/classes/constants, no bodies,
	# no runtime define() calls -- verified: zero `define(` statements in the stub file), so
	# `scanFiles` (parse for signatures only) is correct here. `bootstrapFiles` would actually
	# execute the file, which is unnecessary for a declarations-only stub and is the wrong tool
	# for this job.
	scanFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
